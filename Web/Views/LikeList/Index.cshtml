@model List<LikeItem>
@{
    ViewData["Title"] = "喜好清單";
    var user = ViewBag.User as UserInfo;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1">喜好金融商品清單</h4>
        @if (user != null) { <div class="text-muted small">@user.UserName ｜ 聯絡信箱:@user.Email</div> }
    </div>
    <a class="btn btn-primary" asp-action="Create">＋ 新增</a>
</div>
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="輸入產品名稱或扣款帳號查詢" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>產品名稱</th><th class="text-end">價格</th><th class="text-end">費率</th>
                <th class="text-end">數量</th><th>扣款帳號</th>
                <th class="text-end">總手續費</th><th class="text-end">預計扣款總額</th><th>聯絡信箱</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.ProductName</td>
                <td class="text-end">@i.Price.ToString("N2")</td>
                <td class="text-end">@i.FeeRate.ToString("P2")</td>
                <td class="text-end">@i.PurchaseQuantity</td>
                <td>@i.Account</td>
                <td class="text-end">@i.TotalFee.ToString("N0")</td>
                <td class="text-end">@i.TotalAmount.ToString("N2")</td>
                <td>@i.Email</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@i.SN">修改</a>
                    <form asp-action="Delete" asp-route-id="@i.SN" method="post" class="d-inline"
                          onsubmit="return confirm('確定刪除?');">
                        <button class="btn btn-sm btn-outline-danger">刪除</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">查無資料</td></tr>
        }
        </tbody>
        @if (Model.Any())
        {
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">合計</td>
                    <td class="text-end">@Model.Sum(x => x.TotalFee).ToString("N0")</td>
                    <td class="text-end">@Model.Sum(x => x.TotalAmount).ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
