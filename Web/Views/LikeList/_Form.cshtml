@model LikeItemInput
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="ProductName" class="form-label"></label>
    <input asp-for="ProductName" class="form-control" /><span asp-validation-for="ProductName" class="text-danger"></span></div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><label asp-for="FeeRate" class="form-label"></label>
        <input asp-for="FeeRate" type="number" step="0.0001" min="0" max="1" class="form-control" /><span asp-validation-for="FeeRate" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="PurchaseQuantity" class="form-label"></label>
        <input asp-for="PurchaseQuantity" type="number" min="1" class="form-control" /><span asp-validation-for="PurchaseQuantity" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><label asp-for="Account" class="form-label"></label>
        <input asp-for="Account" class="form-control" /><span asp-validation-for="Account" class="text-danger"></span></div>
</div>
<button type="submit" class="btn btn-primary">儲存</button>
<a class="btn btn-outline-secondary" asp-action="Index">取消</a>
